# The Yard Containers — copy to .env and fill in
APP_ENV=development
PORT=8000
BASE_URL=https://theyardcontainers.com
CANONICAL_URL=https://theyardcontainers.com
DB_PATH=./yards.db
ADMIN_PASSWORD=change-me
SECRET_KEY=
CRON_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Customer-facing sender and contact
MAIL_FROM=The Yard Containers <info@theyardcontainers.com>
CONTACT_EMAIL=info@theyardcontainers.com
# Admin/order alerts recipient
ALERT_EMAIL=info@theyardcontainers.com
# Driver/dispatch emails sender and reply-to
DISPATCH_FROM=The Yard Containers Dispatch <dispatch@theyardcontainers.com>
DISPATCH_REPLY_TO=dispatch@theyardcontainers.com
REMINDER_HOUR=9
TZ=America/Detroit
VOICE_SECRET=        # shared secret header X-Voice-Secret for POST /api/voice/order
# AI phone line: Twilio number -> POST /twilio/voice -> Retell (custom telephony)
RETELL_API_KEY=
RETELL_AGENT_ID=agent_99d6cc33d6d94f7e1e462f0be8
TWILIO_VOICE_URL=https://theyardcontainers.onrender.com/twilio/voice   # exact URL Twilio calls (used for signature check)
